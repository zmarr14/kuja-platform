PORT=3000
JWT_SECRET=any-long-random-string
ADMIN_EMAIL=info@kujaai.com
ADMIN_PASSWORD=your-password
PLATFORM_URL=http://localhost:3000

# Optional — email notifications (leads/bookings). Sending is best-effort; failures are logged, not fatal.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=info@kujaai.com
SMTP_PASS=your-gmail-app-password
EMAIL_FROM=Kuja AI <info@kujaai.com>

# Optional — Google Calendar integration (client "connect calendar" flow only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
